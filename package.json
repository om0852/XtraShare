{
  "name": "xtrashare-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LAN-first AirDrop/LocalSend-style cross-device P2P transfer platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"server,web\" -c \"cyan.bold,green.bold\" \"npm run dev --workspace=@xtrashare/server\" \"npm run dev --workspace=@xtrashare/web\"",
    "dev:server": "npm run dev --workspace=@xtrashare/server",
    "dev:web": "npm run dev --workspace=@xtrashare/web",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@xtrashare/server",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
